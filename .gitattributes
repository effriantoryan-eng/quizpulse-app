# Normalise line endings: LF in the repo for all text files.
# Guards against core.autocrlf=true producing codebase-wide CRLF churn.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
